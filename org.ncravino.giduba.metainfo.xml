<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>org.ncravino.giduba</id>
  <launchable type="desktop-id">org.ncravino.giduba.desktop</launchable>

  <name>Giduba</name>
  <summary>A lean, small, and simple text editor</summary>
  <description>
    <p>Giduba is a lean, small, and simple text editor/notepad alternative in QT.</p>
    <p>The goal of this editor is to be a very simple and fast text editor for quick text editing tasks such as viewing/changing config files, paste buffering, etc.</p>
  </description>

  <metadata_license>CC0-1.0</metadata_license>

  <project_license>GPL-3.0-or-later</project_license>

  <url type="homepage">https://github.com/ncravino/giduba</url>
  <url type="bugtracker">https://github.com/ncravino/giduba/issues</url>

  <developer>
    <name>Nicolas Cravino</name>
  </developer>

  <releases>
    <release version="2.0.0" date="2024-02-20">
      <description>
        <p>Version 2.0.0 - Updated to Qt6</p>
      </description>
    </release>
  </releases>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ncravino/giduba/main/images/screenshot.png</image>
      <caption>Main window of Giduba text editor</caption>
    </screenshot>
  </screenshots>

  <keywords>
    <keyword>text</keyword>
    <keyword>editor</keyword>
    <keyword>notepad</keyword>
    <keyword>simple</keyword>
    <keyword>lightweight</keyword>
  </keywords>

